<Grid xmlns="urn:delta-xaml"
      xmlns:x="urn:delta-xaml"
      Width="800"
      Height="500"
      Background="#666666"
      Rows="*,Auto,*"
      Columns="*,Auto,*">
    <Border Grid.Row="1"
            Grid.Column="1"
            Width="700"
            Height="400"
            Background="#383838"
            CornerRadius="30,30,30,30">
        <TextBlock Text="Data"
                   FontKey="mono"
                   FontSize="48"
                   Foreground="#FFFFFF"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
    </Border>
</Grid>
