<Grid xmlns="urn:delta-xaml"
      xmlns:x="urn:delta-xaml"
      Width="800"
      Height="500"
      Background="#666666"
      Rows="*,Auto,*"
      Columns="*,Auto,*">
    <Border Grid.Row="1"
            Grid.Column="1"
            Width="700"
            Height="400"
            Background="#383838"
            BlendMode="Additive"
            CornerRadius="30,30,30,30">
        <Border.EffectSet>
            <EffectSet>
                <Stroke Color="#28A8BD" Width="5" />
                <OuterGlow Color="#28A8BD" Radius="6" />
            </EffectSet>
        </Border.EffectSet>
        <TextBlock Text="Delta"
                   FontKey="doto"
                   FontSize="48"
                   Foreground="#FFFFFF"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">
            <TextBlock.EffectSet>
                <EffectSet>
                    <OuterShadow Color="#E0000000" Radius="1.5" Offset="0,60" />
                </EffectSet>
            </TextBlock.EffectSet>
        </TextBlock>
    </Border>
</Grid>
