<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeltaXaml.Samples.Game2048.Render</RootNamespace>
    <AssemblyName>DeltaXAML.Samples.Game2048.Render</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;win-x64;linux-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DeltaXAML/DeltaXAML.csproj" />
    <ProjectReference Include="../../src/DeltaXAML.Compiler/DeltaXAML.Compiler.csproj" />
    <ProjectReference Include="../../src/DeltaXAML.Generator/DeltaXAML.Generator.csproj" OutputItemType="Analyzer" />
    <ProjectReference Include="../../src/DeltaXAML.Contract/DeltaXAML.Contract.csproj" />
    <ProjectReference Include="../../../DeltaDiagnostics/src/Delta.Diagnostics.Contract/Delta.Diagnostics.Contract.csproj" />
    <ProjectReference Include="../../../DeltaMaths/src/DeltaMaths/DeltaMaths.csproj" />
    <ProjectReference Include="../../../DeltaText/src/DeltaText/DeltaText.csproj" />
    <ProjectReference Include="../../../DeltaRender/src/DeltaRender/DeltaRender.csproj" />
    <ProjectReference Include="../../../DeltaRender/src/DeltaRender.Platform.SDL3/DeltaRender.Platform.SDL3.csproj" />
    <ProjectReference Include="../../../DeltaRender/src/DeltaRender.Vulkan/DeltaRender.Vulkan.csproj" />
    <ProjectReference Include="../../../DeltaRender/src/DeltaRender.Text/DeltaRender.Text.csproj" />
    <ProjectReference Include="../../../DeltaRender/src/DeltaRender.XAML/DeltaRender.XAML.csproj" />
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader.UI/DeltaShader.UI.csproj" />
    <ProjectReference Include="../../../DeltaShader/src/DeltaShader.Text/DeltaShader.Text.csproj" />
    <PackageReference Include="SDL3-CS" Version="3.4.12.6" />
    <PackageReference Include="Silk.NET.MoltenVK.Native" Version="2.23.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="../../src/DeltaXAML.Generator/bin/$(Configuration)/net8.0/DeltaXAML.Compiler.dll" />
    <Analyzer Include="../../src/DeltaXAML.Generator/bin/$(Configuration)/net8.0/Delta.Diagnostics.Contract.dll" />
    <Analyzer Include="../../src/DeltaXAML.Generator/bin/$(Configuration)/net8.0/DeltaXAML.dll" />
    <Analyzer Include="../../src/DeltaXAML.Generator/bin/$(Configuration)/net8.0/DeltaXAML.Contract.dll" />
    <Analyzer Include="../../src/DeltaXAML.Generator/bin/$(Configuration)/net8.0/DeltaMaths.dll" />
    <Analyzer Include="../../src/DeltaXAML.Generator/bin/$(Configuration)/net8.0/DeltaText.dll" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="DeltaXamlClassName" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="DeltaXamlNamespace" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Game2048/Game2048State.cs" Link="Game2048State.cs" />
    <Compile Include="../Game2048/Game2048View.cs" Link="Game2048View.cs" />
    <AdditionalFiles Include="../Game2048/Game2048.xaml"
                     DeltaXamlClassName="Game2048Artifact"
                     DeltaXamlNamespace="DeltaXaml.Samples.Game2048.Generated" />
    <None Include="../Game2048/Game2048.xaml" Link="Game2048.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../DeltaText/tests/DeltaText.Tests/Fixtures/NotoSans-Regular.ttf"
          Link="Assets/NotoSans-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../DeltaShader/src/DeltaShader/CompiledShaders/DeltaShader.UI.ClipAwareSolidRectangleVertex.vert.spv"
             Link="shaders/ClipAwareSolidRectangleVertex.vert.spv"
             CopyToOutputDirectory="Always" />
    <Content Include="../../../DeltaShader/src/DeltaShader/CompiledShaders/DeltaShader.UI.ClipAwareSolidRectangleFragment.frag.spv"
             Link="shaders/ClipAwareSolidRectangleFragment.frag.spv"
             CopyToOutputDirectory="Always" />
    <Content Include="../../../DeltaShader/src/DeltaShader/CompiledShaders/DeltaShader.UI.ClipAwareRoundedRectangleVertex.vert.spv"
             Link="shaders/ClipAwareRoundedRectangleVertex.vert.spv"
             CopyToOutputDirectory="Always" />
    <Content Include="../../../DeltaShader/src/DeltaShader/CompiledShaders/DeltaShader.UI.ClipAwareRoundedRectangleFragment.frag.spv"
             Link="shaders/ClipAwareRoundedRectangleFragment.frag.spv"
             CopyToOutputDirectory="Always" />
    <Content Include="../../../DeltaShader/src/DeltaShader/CompiledShaders/DeltaShader.UI.ClipAwareRoundedRectangleSliceVertex.vert.spv"
             Link="shaders/ClipAwareRoundedRectangleSliceVertex.vert.spv"
             CopyToOutputDirectory="Always" />
    <Content Include="../../../DeltaShader/src/DeltaShader/CompiledShaders/DeltaShader.UI.ClipAwareRoundedRectangleSliceFragment.frag.spv"
             Link="shaders/ClipAwareRoundedRectangleSliceFragment.frag.spv"
             CopyToOutputDirectory="Always" />
    <Content Include="shaders/SdfTextVertex.vert.spv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="shaders/SdfTextFragment.frag.spv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgSilk_NET_MoltenVK_Native)/runtimes/osx/native/libMoltenVK.dylib"
             Condition=" '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' ">
      <Link>libMoltenVK.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgSilk_NET_MoltenVK_Native)/runtimes/osx/native/MoltenVK_icd.json"
             Condition=" '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' ">
      <Link>MoltenVK_icd.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
