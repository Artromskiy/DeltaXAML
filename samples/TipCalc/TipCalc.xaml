<Grid xmlns:x="urn:delta-xaml"
      x:DataType="DeltaXaml.Samples.TipCalc.TipCalcModel"
      Fill="true"
      Padding="20,20,20,20"
      Columns="180,*"
      Rows="44,44,44,40,56,56"
      Background="#101820">
  <Resource x:Key="InputBackground" Type="Color" Value="#1F2A35" />
  <Resource x:Key="ResultBackground" Type="Color" Value="#405060" />
  <Resource x:Key="PrimaryText" Type="Color" Value="#F2F5F8" />
  <Resource x:Key="Accent" Type="Color" Value="#55C2FF" />

  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontKey" Value="default" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
  </Style>
  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="Height" Value="36" />
    <Setter Property="FontKey" Value="default" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="Background" Value="{DynamicResource InputBackground}" />
  </Style>
  <Style x:Key="Result" TargetType="Border">
    <Setter Property="Padding" Value="10,10,10,10" />
    <Setter Property="Background" Value="{DynamicResource ResultBackground}" />
  </Style>

  <TextBlock Grid.Row="0" Grid.Column="0" Text="Food &amp; Drink:" StyleKey="Label" />
  <TextBox x:Name="SubTotalEditor"
           Grid.Row="0"
           Grid.Column="1"
           StyleKey="Input"
           Text="{Binding SubTotal, Mode=TwoWay, Converter=OptionalDouble}" />

  <TextBlock Grid.Row="1" Grid.Column="0" Text="Total after Tax:" StyleKey="Label" />
  <TextBox x:Name="PostTaxTotalEditor"
           Grid.Row="1"
           Grid.Column="1"
           StyleKey="Input"
           Text="{Binding PostTaxTotal, Mode=TwoWay, Converter=OptionalDouble}" />

  <TextBlock Grid.Row="2" Grid.Column="0" Text="Tip Percent:" StyleKey="Label" />
  <TextBox x:Name="TipPercentEditor"
           Grid.Row="2"
           Grid.Column="1"
           StyleKey="Input"
           Text="{Binding TipPercent, Mode=TwoWay, Converter=OptionalDouble}" />

  <Slider x:Name="TipPercentSlider"
          Grid.Row="3"
          Grid.Column="0"
          Grid.ColumnSpan="2"
          Height="32"
          Minimum="0"
          Maximum="100"
          Step="0.5"
          Value="{Binding TipPercent, Mode=TwoWay, Converter=HalfStep}" />

  <TextBlock Grid.Row="4" Grid.Column="0" Text="Tip Amount:" StyleKey="Label" />
  <Border Grid.Row="4" Grid.Column="1" StyleKey="Result">
    <TextBlock x:Name="TipAmountText"
               Text="{Binding TipAmount, StringFormat='{0:C2}', Culture=en-US}"
               StyleKey="Label"
               Foreground="{DynamicResource Accent}" />
  </Border>

  <TextBlock Grid.Row="5" Grid.Column="0" Text="Total:" StyleKey="Label" />
  <Border Grid.Row="5" Grid.Column="1" StyleKey="Result">
    <TextBlock x:Name="TotalText"
               Text="{Binding Total, StringFormat='{0:C2}', Culture=en-US}"
               StyleKey="Label"
               Foreground="{DynamicResource Accent}" />
  </Border>
</Grid>
