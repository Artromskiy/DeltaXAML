<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeltaXaml.Samples.YageUiLibrary</RootNamespace>
    <AssemblyName>DeltaXAML.Samples.YageUiLibrary</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeltaXAML" Version="*" />
    <PackageReference Include="DeltaXAML.Contract" Version="*" />
    <PackageReference Include="DeltaXAML.Compiler" Version="*" />
    <PackageReference Include="DeltaXAML.Generator" Version="*" PrivateAssets="all" />
    <PackageReference Include="DeltaText" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="DeltaXamlClassName" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="DeltaXamlNamespace" />
    <AdditionalFiles Include="MainWindow.dxaml"
                     DeltaXamlClassName="YageArtifact"
                     DeltaXamlNamespace="DeltaXaml.Samples.YageUiLibrary.Generated" />
    <None Update="MainWindow.dxaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
