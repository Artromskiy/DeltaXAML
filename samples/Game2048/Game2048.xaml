<Border xmlns:x="urn:delta-xaml"
        Fill="true"
        Padding="14,14,14,14"
        Background="#1F1F31"
        CornerRadius="16">
  <Grid Fill="true" Rows="Auto,Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="18,18,18,18"
            Background="#1F1F31"
            CornerRadius="16">
      <Grid Rows="Auto" Columns="*,216">
        <StackPanel>
          <TextBlock Text="2048"
                     FontKey="default"
                     FontSize="48"
                     Foreground="#F4F4FB" />
          <TextBlock Text="Join the numbers and get to the 2048 tile!"
                     FontKey="default"
                     FontSize="14"
                     Foreground="#C9C9DA" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <Grid Rows="Auto" Columns="104,104">
            <Border Width="104"
                    Height="58"
                    Padding="10,6,10,6"
                    Background="#2D2D46"
                    CornerRadius="10">
              <StackPanel>
                <TextBlock Text="SCORE" FontKey="default" FontSize="10" Foreground="#C9C9DA" />
                <TextBlock x:Name="ScoreText" Text="12,456" FontKey="default" FontSize="20" Foreground="#F4F4FB" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Width="104"
                    Height="58"
                    Padding="10,6,10,6"
                    Background="#2D2D46"
                    CornerRadius="10">
              <StackPanel>
                <TextBlock Text="BEST" FontKey="default" FontSize="10" Foreground="#C9C9DA" />
                <TextBlock x:Name="BestText" Text="48,192" FontKey="default" FontSize="20" Foreground="#F4F4FB" />
              </StackPanel>
            </Border>
          </Grid>
          <Button x:Name="NewGameButton"
                  Height="36"
                  Background="#6D5DFC"
                  CornerRadius="10">
            <TextBlock Text="New Game" FontKey="default" FontSize="14" Foreground="#FFFFFF" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Padding="8,8,8,8"
            Background="#2D2D46"
            CornerRadius="12">
      <TextBlock x:Name="StatusText"
                 Text="Use arrow keys to move"
                 FontKey="default"
                 FontSize="16"
                 Foreground="#FFD36F" />
    </Border>

    <Border x:Name="Board"
            Grid.Row="2"
            Fill="true"
            Padding="12,12,12,12"
            Background="#23233A"
            CornerRadius="16">
      <Grid x:Name="BoardGrid"
            Fill="true"
            Rows="*,6,*,6,*,6,*"
            Columns="*,6,*,6,*,6,*">
        <Border x:Name="Tile00" Grid.Row="0" Grid.Column="0" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText00" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile01" Grid.Row="0" Grid.Column="2" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText01" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile02" Grid.Row="0" Grid.Column="4" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText02" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile03" Grid.Row="0" Grid.Column="6" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText03" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile10" Grid.Row="2" Grid.Column="0" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText10" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile11" Grid.Row="2" Grid.Column="2" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText11" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile12" Grid.Row="2" Grid.Column="4" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText12" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile13" Grid.Row="2" Grid.Column="6" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText13" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile20" Grid.Row="4" Grid.Column="0" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText20" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile21" Grid.Row="4" Grid.Column="2" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText21" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile22" Grid.Row="4" Grid.Column="4" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText22" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile23" Grid.Row="4" Grid.Column="6" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText23" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile30" Grid.Row="6" Grid.Column="0" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText30" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile31" Grid.Row="6" Grid.Column="2" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText31" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile32" Grid.Row="6" Grid.Column="4" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText32" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
        <Border x:Name="Tile33" Grid.Row="6" Grid.Column="6" Background="#CDC1B4" CornerRadius="10"><TextBlock x:Name="TileText33" FontKey="default" FontSize="30" Foreground="#776E65" Padding="18,18,0,0" /></Border>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Rows="Auto,Auto">
      <TextBlock Text="Use arrow keys or WASD to move"
                 FontKey="default"
                 FontSize="14"
                 Foreground="#C9C9DA" />
      <Button x:Name="ResetButton"
              Grid.Row="1"
              Height="40"
              Background="#6D5DFC"
              CornerRadius="10">
        <TextBlock Text="New Game" FontKey="default" FontSize="14" Foreground="#FFFFFF" />
      </Button>
    </Grid>
  </Grid>
</Border>
