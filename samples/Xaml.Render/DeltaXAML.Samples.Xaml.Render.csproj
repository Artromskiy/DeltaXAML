<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeltaXaml.Samples.Xaml.Render</RootNamespace>
    <AssemblyName>DeltaXAML.Samples.Xaml.Render</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;win-x64;linux-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Keep public producer dependencies as PackageReference. The workspace
      NuGet workflow supplies local packages first; CI resolves the same IDs
      from NuGet.org without changing this sample project.
    -->
    <PackageReference Include="DeltaRender.UI" Version="*" />

    <!-- 3.4.12.6 matches the compiler supported by the current SDK. -->
    <PackageReference Include="SDL3-CS" Version="3.4.12.6" />
    <PackageReference Include="Silk.NET.MoltenVK.Native" Version="*" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="MainWindow.dxaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UI-Library-Demo/MainWindow.dxaml"
          Link="Sources/UI-Library-Demo/MainWindow.dxaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UI-Library-Demo/GridOnly.dxaml"
          Link="Sources/UI-Library-Demo/GridOnly.dxaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../RoundedRectangle.Render/RoundedRectangle.dxaml"
          Link="Sources/RoundedRectangle/RoundedRectangle.dxaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../DeltaText/tests/DeltaText.Tests/Fixtures/NotoSans-Regular.ttf"
          Link="Assets/NotoSans-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../Furnace/Fonts/Doto/Doto-Variable.ttf"
          Link="Assets/Doto-Variable.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgSilk_NET_MoltenVK_Native)/runtimes/osx/native/libMoltenVK.dylib"
             Condition=" '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' ">
      <Link>libMoltenVK.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgSilk_NET_MoltenVK_Native)/runtimes/osx/native/MoltenVK_icd.json"
             Condition=" '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' ">
      <Link>MoltenVK_icd.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
