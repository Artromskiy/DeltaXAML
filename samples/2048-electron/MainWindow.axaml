<Border xmlns:x="urn:delta-xaml"
        Fill="true"
        Padding="14,14,14,14"
        Background="#081325"
        CornerRadius="16">
  <Grid Fill="true" Rows="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="18,18,18,18" Background="#101A2F" CornerRadius="16">
      <Grid Rows="Auto" Columns="*,Auto,Auto,Auto">
        <StackPanel>
          <TextBlock Text="SNAKE" FontKey="default" FontSize="44" Foreground="#F8F8FF" />
          <TextBlock Text="Собирайте еду и не врезайтесь в себя" FontKey="default" FontSize="14" Foreground="#C9C9DA" />
        </StackPanel>
        <Border Grid.Column="1" Width="118" Height="58" Padding="10,6,10,6" Background="#2C3141" CornerRadius="10">
          <StackPanel>
            <TextBlock Text="СЧЁТ" FontKey="default" FontSize="10" Foreground="#C9C9DA" />
            <TextBlock x:Name="ScoreText" Text="0" FontKey="default" FontSize="20" Foreground="#F4F4FB" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Width="118" Height="58" Padding="10,6,10,6" Background="#2C3141" CornerRadius="10">
          <StackPanel>
            <TextBlock Text="РЕКОРД" FontKey="default" FontSize="10" Foreground="#C9C9DA" />
            <TextBlock x:Name="BestText" Text="0" FontKey="default" FontSize="20" Foreground="#F4F4FB" />
          </StackPanel>
        </Border>
        <Button x:Name="NewGameButton" Grid.Column="3" Height="38" Background="#3A5ACD" CornerRadius="10">
          <TextBlock Text="Новая игра" FontKey="default" FontSize="14" Foreground="#FFFFFF" />
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="1" Padding="8,8,8,8" Background="#222839" CornerRadius="12">
      <TextBlock x:Name="StatusText" Text="Игра идёт — стрелки или WASD" FontKey="default" FontSize="16" Foreground="#FFD36F" />
    </Border>
    <Border Grid.Row="2" Padding="12,12,12,12" Background="#1A2338" CornerRadius="16">
      <Grid x:Name="BoardGrid" Fill="true" Rows="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*" Columns="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*">
        <Border x:Name="CellR00C00" Grid.Row="0" Grid.Column="0" Background="#1A2338" CornerRadius="4" />
        <Border x:Name="CellR00C01" Grid.Row="0" Grid.Column="1" Background="#1A2338" CornerRadius="4" />
        <Border x:Name="CellR00C02" Grid.Row="0" Grid.Column="2" Background="#1A2338" CornerRadius="4" />
