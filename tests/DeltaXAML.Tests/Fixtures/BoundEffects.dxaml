<Border xmlns="urn:delta-xaml"
        xmlns:x="urn:delta-xaml"
        x:Name="Surface"
        x:DataType="DeltaXaml.Tests.EffectBindingModel"
        Width="120"
        Height="80"
        Background="#202840"
        CornerRadius="12">
  <Border.EffectSet>
    <EffectSet>
      <Stroke Color="{Binding Accent}" Width="{Binding StrokeWidth}" />
      <OuterShadow Color="{Binding Accent}" Radius="{Binding OuterGlowRadius}" Offset="0,2" />
      <InnerShadow Color="{Binding Accent}" Radius="{Binding OuterGlowRadius}" />
      <OuterGlow Color="{Binding OuterGlowColor, Mode=OneTime}" Radius="{Binding OuterGlowRadius}" />
      <InnerGlow Color="{Binding Accent}" Radius="{Binding OuterGlowRadius}" />
    </EffectSet>
  </Border.EffectSet>
</Border>
