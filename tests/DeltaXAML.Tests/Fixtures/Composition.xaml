<Panel Fill="true" Background="#101820">
  <Resource x:Key="Accent" Type="Color" Value="#304860" />
  <TextBlock x:Key="SharedLabel" Text="resource" />
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <VisualState Name="Pressed">
      <Setter Property="Background" Value="#486C90" />
    </VisualState>
  </Style>
  <Template x:Key="PrimaryButtonTemplate">
    <TextBlock Text="Generated template" FontKey="default" FontSize="14" Foreground="#FFFFFF" Background="{TemplateBinding Background}" />
  </Template>
  <Button x:Name="Action" Width="180" Height="40" StyleKey="PrimaryButton" TemplateKey="PrimaryButtonTemplate" />
</Panel>
