<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeltaXAML.Contract</AssemblyName>
    <PackageId>DeltaXAML.Contract</PackageId>
    <Version>0.0.15</Version>
    <IsPackable>true</IsPackable>
    <Authors>Artromskiy</Authors>
    <Description>Neutral input and borrowed UI display-list contracts for DeltaXAML consumers.</Description>
    <PackageTags>xaml;ui;input;display-list;contracts</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaXAML</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RootNamespace>Delta.XAML.Contract</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../docs/CONTRACT.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
    <PackageReference Include="DeltaMaths" Version="*" />
    <PackageReference Include="DeltaText" Version="*" />
  </ItemGroup>
</Project>
