<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeltaXAML.Generator</RootNamespace>
    <AssemblyName>DeltaXAML.Generator</AssemblyName>
    <PackageId>DeltaXAML.Generator</PackageId>
    <Version>0.0.17</Version>
    <IsPackable>true</IsPackable>
    <Authors>Artromskiy</Authors>
    <Description>Build-time Roslyn incremental generator for compiled DeltaXAML documents.</Description>
    <PackageTags>xaml;roslyn;source-generator;build-time</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaXAML</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- The build-time analyzer targets net8 and carries its compiler companions. -->
    <NoWarn>$(NoWarn);RS1041;RS1036;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../docs/README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
    <ProjectReference Include="../DeltaXAML.Compiler/DeltaXAML.Compiler.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" PrivateAssets="all" />
    <PackageReference Include="Delta.Diagnostics.Contract" Version="*" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="DeltaMaths" Version="*" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopyDeltaDiagnosticsGeneratorDependency" BeforeTargets="CoreCompile">
    <Copy SourceFiles="$(PkgDelta_Diagnostics_Contract)/lib/net8.0/Delta.Diagnostics.Contract.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDeltaMathsGeneratorDependency" BeforeTargets="CoreCompile">
    <Copy SourceFiles="$(PkgDeltaMaths)/lib/net8.0/DeltaMaths.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="false" />
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectDeltaXamlGeneratorPackageFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CollectDeltaXamlGeneratorPackageFiles" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)">
        <PackagePath>analyzers/dotnet/cs/$(TargetFileName)</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(TargetDir)**/*.dll" Exclude="$(TargetPath)">
        <PackagePath>analyzers/dotnet/cs/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
