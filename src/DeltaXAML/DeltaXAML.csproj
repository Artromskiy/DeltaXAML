<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Delta.XAML</RootNamespace>
    <AssemblyName>DeltaXAML</AssemblyName>
    <PackageId>DeltaXAML</PackageId>
    <Version>0.0.15</Version>
    <IsPackable>true</IsPackable>
    <Authors>Artromskiy</Authors>
    <Description>Retained XAML UI library with typed properties, bindings and layout.</Description>
    <PackageTags>xaml;ui;retained-ui;layout;bindings</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaXAML</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../docs/USER_API.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
    <ProjectReference Include="../DeltaXAML.Contract/DeltaXAML.Contract.csproj" />
    <PackageReference Include="Delta.Diagnostics.Contract" Version="*" />
    <PackageReference Include="DeltaMaths" Version="*" />
    <PackageReference Include="DeltaText" Version="*" />
  </ItemGroup>
</Project>
