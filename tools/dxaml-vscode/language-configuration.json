{
  "comments": {
    "blockComment": [
      "<!--",
      "-->"
    ]
  },
  "brackets": [
    [
      "<",
      ">"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "autoCloseBefore": ">\n\t ",
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "{",
      "}"
    ]
  ],
  "wordPattern": "(-?\\d*\\.\\d+|[A-Za-z_][\\w.-]*)",
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#?region\\b",
      "end": "^\\s*<!--\\s*#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "<(?!(?:/|!))([A-Za-z_][\\w:.-]*)\\b[^<>]*>(?!\\s*</\\1\\s*>)",
    "decreaseIndentPattern": "^\\s*</[A-Za-z_][\\w:.-]*\\s*>"
  }
}
