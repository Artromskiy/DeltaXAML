{
  "name": "delta-xaml-language",
  "displayName": "DeltaXAML Language",
  "description": "Syntax highlighting for the DeltaXAML .dxaml dialect.",
  "version": "0.1.2",
  "publisher": "artromskiy",
  "license": "MIT",
  "scripts": {
    "test": "node test/grammar-smoke.mjs"
  },
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "delta-xaml",
        "aliases": [
          "DeltaXAML",
          "DXAML"
        ],
        "extensions": [
          ".dxaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "delta-xaml",
        "scopeName": "source.dxaml",
        "path": "./syntaxes/dxaml.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "delta-xaml",
        "path": "./snippets/dxaml.code-snippets"
      }
    ]
  }
}
